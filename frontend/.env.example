# In development, Vite proxies /api to the Spring Boot backend (see vite.config.js)
# so this can be left unset.
#
# In production, the frontend and backend are typically deployed on different
# origins. Set this to the backend's public URL so the React app talks to it
# directly over HTTPS (the backend must allow this origin in
# security.cors.allowed-origins).
# VITE_API_BASE_URL=https://api.example.com/api
